---
export const prerender = false;
import { providers } from "@finon/connect";
import Playground from "../components/Playground/index";
import "../styles/global.css";

const provider = providers.find((p) => p.id === Astro.params.provider);
if (!provider) return Astro.redirect("/");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{provider.name} — @finon/connect playground</title>
  </head>
  <body>
    <main>
      <header class="page-header">
        <p class="breadcrumb"><a href="/">← All providers</a></p>
        <h1>{provider.name}</h1>
      </header>
      <Playground provider={provider} client:load />
    </main>
  </body>
</html>
